{
  "name": "@biz42/cli",
  "version": "0.0.2",
  "description": "CLI for validating and querying biz42 DSL files.",
  "keywords": [
    "biz42",
    "business-model",
    "cli",
    "documentation",
    "dsl",
    "iso9001",
    "validation"
  ],
  "homepage": "https://github.com/mrsimpson/biz42",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mrsimpson/biz42.git"
  },
  "bin": {
    "biz42": "./dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/cli.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "check:templates": "node --conditions=development --experimental-strip-types --no-warnings ../../scripts/check-starter-templates.ts",
    "prebuild": "pnpm run check:templates && pnpm --filter @biz42/workspace-fs build",
    "build": "pnpm build:web && pnpm build:web:single && vp pack",
    "build:web": "pnpm --filter @biz42/web build",
    "build:web:single": "pnpm --filter @biz42/web build:single",
    "dev": "vp pack --watch",
    "test": "vp test",
    "test:e2e": "pnpm --filter @biz42/web test:e2e",
    "check": "pnpm run check:templates && vp check",
    "prepack": "pnpm run check:templates"
  },
  "devDependencies": {
    "@biz42/core": "workspace:*",
    "@biz42/workspace-fs": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  }
}
