{
  "name": "@biz42/web",
  "version": "0.1.0",
  "private": true,
  "description": "SPA for browsing biz42 business model workspaces.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vp build",
    "build:single": "tsc --noEmit && vp build --config vite.config.single.ts",
    "dev": "vp dev",
    "check": "vp check",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug=cli"
  },
  "dependencies": {
    "@biz42/core": "workspace:*",
    "marked": "^14.0.0",
    "mermaid": "11.17.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "catalog:",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-singlefile": "2.3.3",
    "vite-plus": "catalog:"
  }
}
