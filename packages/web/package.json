{
  "name": "@biz42/web",
  "version": "0.1.0",
  "private": true,
  "description": "SPA for browsing biz42 business model workspaces.",
  "license": "MIT",
  "type": "module",
  "exports": {
    "./history-format": "./src/history-format.ts"
  },
  "scripts": {
    "build": "tsc --noEmit && vp build",
    "build:single": "tsc --noEmit && vp build --config vite.config.single.ts",
    "dev": "vp dev",
    "check": "vp check",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug=cli",
    "demo:evolution": "playwright test --project=demo"
  },
  "dependencies": {
    "@biz42/core": "workspace:*",
    "@cli42/lib": "catalog:",
    "marked": "^14.0.0",
    "mermaid": "11.17.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "catalog:",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-singlefile": "catalog:",
    "vite-plus": "catalog:"
  }
}
